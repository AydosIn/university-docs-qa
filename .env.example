# Copy to .env and fill in.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=university_docs_qa
# Leave these empty to use the local Postgres.app socket and your macOS user.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=

# Needed to generate answers. Create a key at https://platform.claude.com
# ANTHROPIC_API_KEY=
# LLM_MODEL=claude-opus-5-5

# Optional: the Telegram bot.
# TELEGRAM_BOT_TOKEN=
